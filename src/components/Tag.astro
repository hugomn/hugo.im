---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class={`inline-block ${size === "sm" ? "my-1 mr-1" : "my-2 mr-2"}`}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`tag ${size === "sm" ? "px-3 py-1 text-sm" : "px-4 py-1.5 text-base"}`}
  >
    <span class="tag-hash" aria-hidden="true">#</span>{tag}
  </a>
</li>

<style>
  .tag {
    @apply inline-flex items-center rounded-full border border-skin-line font-medium text-skin-muted transition-colors hover:border-skin-accent hover:text-skin-accent;
  }
  .tag-hash {
    @apply mr-0.5 opacity-60;
  }
</style>
