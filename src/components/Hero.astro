---
import { Picture } from "astro:assets";
import { getTranslator, localizeUrl } from "@utils/i18n";
import heroPortrait from "@assets/images/hero-portrait.jpg";

const locale = Astro.currentLocale;
const t = getTranslator(locale);

// Set a trailing full stop in the accent colour (typographic detail only;
// the copy itself lives in translations.ts).
const title = t("home.title").replace(
  /\.(\s*)$/,
  '<span class="hero-stop">.</span>$1'
);

const credentials = [
  { label: t("home.cred.1") },
  { label: t("home.cred.2") },
  { label: t("home.cred.3") },
  { label: t("home.cred.4"), href: "https://huggingface.co/hugonogueira" },
];
---

<!--
  Homepage hero: a dark navy-and-gold banner in both themes. The art is the
  portrait banner cropped to the portrait and gold disc; CSS masks fade its
  edges into the band so the photo has no visible frame.
-->
<div class="hero-band">
  <div class="hero-art">
    <Picture
      src={heroPortrait}
      alt={t("rail.portraitAlt")}
      formats={["avif", "webp"]}
      widths={[480, 800, 1100, 1383]}
      sizes="(min-width: 1024px) 960px, 100vw"
      quality={78}
      loading="eager"
      fetchpriority="high"
      class="hero-art-img"
      pictureAttributes={{ class: "hero-art-picture" }}
    />
  </div>

  <section id="hero">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span>{t("home.eyebrow")}</span>
        <span class="hero-rule" aria-hidden="true"></span>
      </p>
      <h1 set:html={title} />
      <p class="hero-bio" set:html={t("home.bio")} />
      <div class="hero-ctas">
        <a
          class="hero-cta hero-cta--primary"
          href={`${localizeUrl(locale, "/projects")}/`}
        >
          {t("home.cta.primary")}
        </a>
        <a
          class="hero-cta hero-cta--secondary"
          href={`${localizeUrl(locale, "/posts")}/`}
        >
          {t("home.cta.secondary")}
        </a>
      </div>
    </div>
  </section>
</div>

<div class="hero-cred">
  <ul>
    {
      credentials.map(item => (
        <li>
          {item.href ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          ) : (
            item.label
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* The band is always dark, so it re-points the theme tokens for its children */
  .hero-band {
    --color-text-base: 238, 241, 245;
    --color-text-muted: 182, 192, 205;
    --color-accent: 227, 178, 90;
    --hero-navy: #06121a;
    @apply relative isolate overflow-hidden text-skin-base;
    background:
      radial-gradient(
        90% 120% at 18% 0%,
        rgba(16, 52, 70, 0.55) 0%,
        transparent 60%
      ),
      linear-gradient(
        115deg,
        transparent 0 38%,
        rgba(255, 255, 255, 0.025) 38% 52%,
        transparent 52%
      ),
      linear-gradient(180deg, #0a1e2a 0%, var(--hero-navy) 100%);
  }
  :global([data-theme="dark"]) .hero-band {
    --hero-navy: #0b1220;
  }

  /* ---- Portrait art ---- */
  .hero-art {
    @apply relative w-full overflow-hidden;
    height: clamp(15rem, 58vw, 26rem);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
  }
  .hero-art :global(.hero-art-picture) {
    @apply block h-full w-full;
  }
  .hero-art :global(.hero-art-img) {
    @apply h-full w-full object-cover;
    object-position: 26% 18%;
  }

  /* ---- Copy ---- */
  #hero {
    @apply relative -mt-10 pb-12 sm:-mt-14 sm:pb-16;
  }
  .hero-copy {
    @apply max-w-[36rem];
  }
  .hero-eyebrow {
    @apply mb-5 flex items-center gap-3 text-[0.9375rem] font-medium text-skin-accent;
  }
  .hero-rule {
    @apply block h-px w-12 bg-skin-accent;
  }
  #hero h1 {
    @apply font-serif text-[2.4rem] font-semibold leading-[1.06] tracking-[-0.025em] sm:text-[3.25rem];
    text-wrap: balance;
  }
  #hero h1 :global(.hero-stop) {
    @apply text-skin-accent;
  }
  .hero-bio {
    @apply mt-6 font-serif text-[1.0625rem] leading-relaxed text-skin-muted sm:text-[1.125rem];
  }
  .hero-bio :global(a) {
    @apply text-skin-base underline decoration-1 underline-offset-4 transition-colors hover:text-skin-accent;
    text-decoration-color: rgba(var(--color-accent), 0.7);
  }
  .hero-ctas {
    @apply mt-8 flex flex-wrap gap-3;
  }
  .hero-cta {
    @apply inline-flex items-center rounded-full px-5 py-2.5 text-[0.9375rem] font-semibold transition-colors;
  }
  .hero-cta--primary {
    background: #e3b25a;
    color: #0b1220;
  }
  .hero-cta--primary:hover {
    background: #edc679;
  }
  .hero-cta--secondary {
    @apply text-skin-base;
    box-shadow: inset 0 0 0 1px rgba(238, 241, 245, 0.35);
  }
  .hero-cta--secondary:hover {
    box-shadow: inset 0 0 0 1px rgba(227, 178, 90, 0.9);
  }

  /* ---- Credibility strip ---- */
  .hero-cred {
    @apply border-b border-skin-line;
  }
  .hero-cred ul {
    @apply mx-auto flex max-w-5xl flex-col gap-y-1.5 px-4 py-4 text-sm text-skin-muted sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3;
  }
  .hero-cred li {
    @apply flex items-center gap-x-3;
  }
  /* Mobile: a short list with gold bullets; wider screens: one line with gold separators */
  .hero-cred li::before {
    content: "";
    @apply inline-block h-1 w-1 shrink-0 rounded-full bg-skin-accent;
  }
  @media (min-width: 640px) {
    .hero-cred li:first-child::before {
      content: none;
    }
  }
  .hero-cred a {
    @apply underline decoration-1 underline-offset-4 transition-colors hover:text-skin-accent;
    text-decoration-color: rgba(var(--color-accent), 0.5);
  }

  /* ---- Desktop: copy left, portrait right, edges dissolved into the band ---- */
  @media (min-width: 1024px) {
    .hero-band {
      min-height: 34rem;
      @apply flex items-center;
    }
    .hero-art {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(50% - 6rem);
      width: auto;
      height: auto;
      /* fade the left and right edges and the bottom of the sweater */
      -webkit-mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.55) 9%,
          #000 22%,
          #000 86%,
          transparent 100%
        ),
        linear-gradient(180deg, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.55) 9%,
          #000 22%,
          #000 86%,
          transparent 100%
        ),
        linear-gradient(180deg, #000 82%, transparent 100%);
      mask-composite: intersect;
    }
    .hero-art :global(.hero-art-picture) {
      @apply h-full w-auto;
    }
    .hero-art :global(.hero-art-img) {
      @apply h-full w-auto max-w-none;
    }
    #hero {
      @apply mt-0 w-full py-20;
    }
    .hero-copy {
      @apply max-w-[31rem];
    }
    #hero h1 {
      @apply text-[3.25rem];
    }
  }

  /* Wide screens: room for a two-line bio beside the portrait */
  @media (min-width: 1280px) {
    .hero-art {
      left: calc(50% + 1rem);
    }
    .hero-copy {
      @apply max-w-[43rem];
    }
    #hero h1 {
      @apply max-w-[36rem] text-[3.5rem];
    }
    .hero-bio {
      @apply text-[1.0625rem];
    }
  }

  /* One orchestrated entrance: copy rises in, the portrait fades up behind it */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy {
      animation: hero-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero-art {
      animation: hero-fade 1100ms ease-out both;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
