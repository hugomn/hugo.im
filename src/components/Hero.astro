---
import { Picture } from "astro:assets";
import Socials from "@components/Socials.astro";
import { SOCIALS } from "@config";
import { getTranslator } from "@utils/i18n";
import heroPortrait from "@assets/images/hero-portrait.jpg";

const t = getTranslator(Astro.currentLocale);

// Set a trailing full stop in the accent colour (typographic detail only;
// the copy itself lives in translations.ts).
const title = t("home.title").replace(
  /\.(\s*)$/,
  '<span class="hero-stop">.</span>$1'
);
const socialCount = SOCIALS.filter(social => social.active).length;
---

<!--
  Homepage hero: a dark navy-and-gold banner in both themes. The art is the
  portrait banner cropped to the portrait and gold disc; CSS masks fade its
  edges into the band so the photo has no visible frame.
-->
<div class="hero-band">
  <div class="hero-art">
    <Picture
      src={heroPortrait}
      alt="Portrait of Hugo Nogueira"
      formats={["avif", "webp"]}
      widths={[480, 800, 1100, 1383]}
      sizes="(min-width: 1024px) 960px, 100vw"
      quality={78}
      loading="eager"
      fetchpriority="high"
      class="hero-art-img"
      pictureAttributes={{ class: "hero-art-picture" }}
    />
  </div>

  <section id="hero">
    <div class="hero-copy">
      <span class="hero-rule" aria-hidden="true"></span>
      <h1 set:html={title} />
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>

      <p set:html={t("home.bio")} />
      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <Socials />
          </div>
        )
      }
    </div>
  </section>
</div>

<style>
  /* The band is always dark, so it re-points the theme tokens for its children */
  .hero-band {
    --color-text-base: 238, 241, 245;
    --color-text-muted: 182, 192, 205;
    --color-accent: 227, 178, 90;
    --hero-navy: #06121a;
    @apply relative isolate overflow-hidden text-skin-base;
    background:
      radial-gradient(
        90% 120% at 18% 0%,
        rgba(16, 52, 70, 0.55) 0%,
        transparent 60%
      ),
      linear-gradient(
        115deg,
        transparent 0 38%,
        rgba(255, 255, 255, 0.025) 38% 52%,
        transparent 52%
      ),
      linear-gradient(180deg, #0a1e2a 0%, var(--hero-navy) 100%);
  }

  :global([data-theme="dark"]) .hero-band {
    --hero-navy: #0b1220;
  }

  /* ---- Portrait art ---- */
  .hero-art {
    @apply relative w-full overflow-hidden;
    height: clamp(15rem, 58vw, 26rem);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
  }
  .hero-art :global(.hero-art-picture) {
    @apply block h-full w-full;
  }
  .hero-art :global(.hero-art-img) {
    @apply h-full w-full object-cover;
    object-position: 26% 18%;
  }

  /* ---- Copy ---- */
  #hero {
    @apply relative -mt-10 pb-12 sm:-mt-14 sm:pb-16;
  }
  .hero-copy {
    @apply max-w-[36rem];
  }
  .hero-rule {
    @apply mb-6 block h-[3px] w-14 rounded-full bg-skin-accent;
  }
  #hero h1 {
    @apply inline font-serif text-[2.6rem] font-semibold leading-[1.04] tracking-[-0.025em] sm:text-[3.5rem];
    text-wrap: balance;
  }
  #hero h1 :global(.hero-stop) {
    @apply text-skin-accent;
  }
  #hero .rss-link {
    @apply ml-1 inline-block align-baseline;
  }
  #hero .rss-icon {
    @apply h-5 w-5 fill-skin-accent sm:h-6 sm:w-6;
  }
  #hero p {
    @apply mt-6 font-serif text-[1.125rem] leading-relaxed text-skin-muted sm:text-[1.1875rem];
  }
  #hero p :global(a) {
    @apply text-skin-base underline decoration-1 underline-offset-4 transition-colors hover:text-skin-accent;
    text-decoration-color: rgba(var(--color-accent), 0.7);
  }
  .social-wrapper {
    @apply -ml-2 mt-7 flex;
  }

  /* ---- Desktop: copy left, portrait right, edges dissolved into the band ---- */
  @media (min-width: 1024px) {
    .hero-band {
      min-height: 34rem;
      @apply flex items-center;
    }
    .hero-art {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(50% - 8rem);
      width: auto;
      height: auto;
      /* fade the left and right edges and the bottom of the sweater */
      -webkit-mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.55) 9%,
          #000 22%,
          #000 86%,
          transparent 100%
        ),
        linear-gradient(180deg, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.55) 9%,
          #000 22%,
          #000 86%,
          transparent 100%
        ),
        linear-gradient(180deg, #000 82%, transparent 100%);
      mask-composite: intersect;
    }
    .hero-art :global(.hero-art-picture) {
      @apply h-full w-auto;
    }
    .hero-art :global(.hero-art-img) {
      @apply h-full w-auto max-w-none;
    }
    #hero {
      @apply mt-0 w-full py-20;
    }
    .hero-copy {
      @apply max-w-[29rem];
    }
    #hero h1 {
      @apply text-[3.75rem];
    }
  }
</style>
