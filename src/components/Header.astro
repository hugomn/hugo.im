---
import { LOGO_IMAGE, SITE } from "@config";
import Hr from "./Hr.astro";
import { getTranslator, localizeUrl } from "@utils/i18n";

export interface Props {
  activeNav?:
    | "posts"
    | "archives"
    | "tags"
    | "about"
    | "search"
    | "contact"
    | "talks"
    | "investing"
    | "projects";
  /** Hide the small header avatar (the homepage hero already shows the portrait) */
  hideAvatar?: boolean;
}

const { activeNav, hideAvatar = false } = Astro.props;
const t = getTranslator(Astro.currentLocale);
const locale = Astro.currentLocale;

const navItems = [
  { key: "about", href: localizeUrl(locale, "/about"), label: t("nav.about") },
  {
    key: "posts",
    href: `${localizeUrl(locale, "/posts")}/`,
    label: t("nav.posts"),
  },
  {
    key: "projects",
    href: localizeUrl(locale, "/projects"),
    label: t("nav.research"),
  },
  { key: "talks", href: localizeUrl(locale, "/talks"), label: t("nav.talks") },
  {
    key: "investing",
    href: localizeUrl(locale, "/investing"),
    label: t("nav.investing"),
  },
  {
    key: "contact",
    href: localizeUrl(locale, "/contact"),
    label: t("nav.contact"),
  },
] as const;
---

<header>
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="nav-container">
    <div class="top-nav-wrap">
      <a
        href={localizeUrl(locale, "/")}
        class="logo flex flex-row items-center whitespace-nowrap"
      >
        {
          LOGO_IMAGE.enable ? (
            <img
              src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
              alt={SITE.title}
              width={LOGO_IMAGE.width}
              height={LOGO_IMAGE.height}
            />
          ) : (
            <>
              <div
                class:list={["avatar mr-2", { "avatar--hidden": hideAvatar }]}
              >
                <img src={`/assets/profile_picture.jpg`} alt={SITE.title} />
              </div>
              {SITE.title}
            </>
          )
        }
      </a>
      <nav id="nav-menu">
        <button
          class="hamburger-menu focus-outline"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="menu-icon"
          >
            <line x1="7" y1="12" x2="21" y2="12" class="line"></line>
            <line x1="3" y1="6" x2="21" y2="6" class="line"></line>
            <line x1="12" y1="18" x2="21" y2="18" class="line"></line>
            <line x1="18" y1="6" x2="6" y2="18" class="close"></line>
            <line x1="6" y1="6" x2="18" y2="18" class="close"></line>
          </svg>
        </button>
        <ul id="menu-items" class="display-none md:flex">
          {
            navItems.map(item => (
              <li>
                <a
                  href={item.href}
                  class={activeNav === item.key ? "active" : ""}
                  aria-current={activeNav === item.key ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="nav-utils">
            <a
              href="/search/"
              class:list={["icon-btn", { active: activeNav === "search" }]}
              aria-label={t("nav.search")}
              title={t("nav.search")}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="ui-icon"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="6.25"></circle>
                <path d="m19.5 19.5-3.9-3.9"></path>
              </svg>
            </a>
            {
              SITE.lightAndDarkMode && (
                <button
                  id="theme-btn"
                  class="icon-btn theme-toggle"
                  title={t("nav.theme")}
                  aria-label={t("nav.theme")}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="ui-icon icon-moon"
                    aria-hidden="true"
                  >
                    <path d="M19.5 14.2A7.75 7.75 0 0 1 9.8 4.5a7.75 7.75 0 1 0 9.7 9.7Z" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="ui-icon icon-sun"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="3.75" />
                    <path d="M12 3v1.75M12 19.25V21M3 12h1.75M19.25 12H21M5.64 5.64l1.24 1.24M17.12 17.12l1.24 1.24M5.64 18.36l1.24-1.24M17.12 6.88l1.24-1.24" />
                  </svg>
                </button>
              )
            }
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<style>
  :root {
    --size-avatar: 40px;
    --size-border: 2px;
  }
  #skip-to-content {
    @apply absolute -top-full left-16 z-50 bg-skin-accent px-3 py-2 text-skin-inverted transition-all focus:top-4;
  }
  .nav-container {
    @apply mx-auto flex max-w-5xl flex-col items-center justify-between md:flex-row;
  }
  .top-nav-wrap {
    @apply relative flex w-full items-start justify-between p-4 md:items-center md:py-6;
  }
  .logo {
    @apply absolute py-1 text-[1.0625rem] font-bold tracking-[-0.01em] md:static md:text-lg;
  }
  .logo .avatar {
    @apply mr-2.5 rounded-full;
    background: rgba(var(--color-accent), 0.55);
    height: var(--size-avatar);
    width: var(--size-avatar);
    min-width: var(--size-avatar);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: var(--size-border);
    border: 0;
  }
  .logo {
    min-height: var(--size-avatar);
  }
  .logo .avatar.avatar--hidden {
    display: none;
  }
  .logo > .avatar > img {
    @apply rounded-full;
    height: auto;
    width: 100%;
    transition: transform 0.6s ease-in-out;
    border-color: rgba(var(--color-fill), var(--tw-bg-opacity));
    border-width: var(--size-border);
  }
  .hamburger-menu {
    @apply self-end p-2 md:hidden;
  }
  .hamburger-menu svg {
    @apply h-6 w-6 scale-125 fill-skin-base;
  }

  nav {
    @apply flex w-full flex-col items-center md:ml-2 md:flex-row md:justify-end md:space-x-4 md:py-0;
  }
  nav ul {
    @apply mt-4 grid w-44 grid-cols-2 grid-rows-4 gap-x-2 gap-y-2 md:ml-0 md:mt-0 md:w-auto md:gap-x-5 md:gap-y-0;
  }
  nav ul li {
    @apply col-span-2 flex items-center justify-center;
  }
  nav ul li a {
    @apply w-full px-4 py-3 text-center text-[0.9375rem] font-medium text-skin-muted transition-colors hover:text-skin-base md:my-0 md:px-2 md:py-1;
  }
  nav .active {
    @apply text-skin-base underline decoration-2 underline-offset-[6px];
    text-decoration-color: rgb(var(--color-accent));
  }
  nav a.active svg {
    @apply fill-skin-accent;
  }

  /* ---- Utility icons: one outline family, 20px, 1.5px stroke ---- */
  .nav-utils {
    @apply mt-2 gap-1 md:ml-1 md:mt-0 md:border-l md:border-skin-line md:pl-3;
  }
  .icon-btn {
    @apply relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full p-0 text-skin-muted transition-colors hover:text-skin-accent;
  }
  .icon-btn.active {
    @apply text-skin-accent;
  }
  .icon-btn:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .ui-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Sun and moon share the button and cross-fade with a quarter turn */
  .theme-toggle .ui-icon {
    position: absolute;
    transition:
      opacity 250ms ease,
      transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .theme-toggle .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(html[data-theme="dark"]) .theme-toggle .icon-sun {
    opacity: 1;
    transform: none;
  }
  :global(html[data-theme="dark"]) .theme-toggle .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .menu-icon line {
    @apply transition-opacity duration-75 ease-in-out;
  }
  .menu-icon .close {
    opacity: 0;
  }
  .menu-icon.is-active .line {
    @apply opacity-0;
  }
  .menu-icon.is-active .close {
    @apply opacity-100;
  }
</style>

<script>
  function toggleNav() {
    // Toggle menu
    const menuBtn = document.querySelector(".hamburger-menu");
    const menuIcon = document.querySelector(".menu-icon");
    const menuItems = document.querySelector("#menu-items");

    menuBtn?.addEventListener("click", () => {
      const menuExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuIcon?.classList.toggle("is-active");
      menuBtn.setAttribute("aria-expanded", menuExpanded ? "false" : "true");
      menuBtn.setAttribute(
        "aria-label",
        menuExpanded ? "Open Menu" : "Close Menu"
      );
      menuItems?.classList.toggle("display-none");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
