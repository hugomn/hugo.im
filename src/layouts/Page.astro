---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Layout from "./Layout.astro";
import Header from "@components/Header.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    slug?: typeof Header.prototype.activeNav;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header activeNav={frontmatter.slug} />
  <Breadcrumbs />
  <main id="main-content">
    <section id="about" class="mb-28">
      <div class="prose prose-lg max-w-[42rem]">
        <h1 class="mt-2 text-3xl font-bold tracking-[-0.025em] sm:text-4xl">
          {frontmatter.title}
        </h1>
        <slot />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
