---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import RecentPosts from "@components/RecentPosts.astro";
import FeaturedCard from "@components/FeaturedCard.astro";
import Hero from "@components/Hero.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";
import { getTranslator, localizeUrl } from "@utils/i18n";
import getReadingTime from "@utils/readingTime";

const posts = await getCollection("blog");

const locale = "pt";
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured && data.locale == locale
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !data.featured && data.locale == locale
);
const t = getTranslator(Astro.currentLocale);
---

<Layout>
  <Header hideAvatar />
  <main id="main-content">
    <Hero />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <div class="featured-container">
              <h2>{t("home.featured")}</h2>
              <div class="featured-grid">
                {featuredPosts.map(({ data, body }, index) => (
                  <FeaturedCard
                    href={localizeUrl(
                      Astro.currentLocale,
                      `/posts/${data.postSlug}/`
                    )}
                    frontmatter={data}
                    lead={index === 0}
                    readingTime={getReadingTime(body)}
                    readingLabel={t("post.minRead")}
                  />
                ))}
              </div>
            </div>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <RecentPosts posts={recentPosts.slice(0, SITE.postPerIndex)} />
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href={`${localizeUrl(Astro.currentLocale, "/posts")}/`}>
        {t("home.allPosts")}
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Featured Posts Section ===== */
  #featured {
    @apply pb-12 pt-10 md:pb-16 md:pt-12;
  }

  .featured-container {
    @apply mx-auto;
    max-width: 1280px;
  }

  .featured-grid {
    @apply mt-6 grid grid-cols-1 gap-5;
  }

  @media (min-width: 768px) {
    .featured-grid {
      @apply grid-cols-2;
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      @apply grid-cols-3;
    }
  }

  #featured h2 {
    @apply text-xl font-bold tracking-tight sm:text-2xl;
  }
  .all-posts-btn-wrapper {
    @apply mb-16 mt-6 px-4 text-center;
  }
  .all-posts-btn-wrapper :global(a) {
    @apply inline-flex items-center gap-1 rounded-full border border-skin-line px-5 py-2.5 font-semibold transition-colors hover:border-skin-accent;
  }
  .all-posts-btn-wrapper :global(svg) {
    @apply h-5 w-5;
  }
</style>
