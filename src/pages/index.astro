---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import FeaturedCard from "@components/FeaturedCard.astro";
import Hero from "@components/Hero.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";
import { localizeUrl } from "@utils/i18n";

const posts = await getCollection("blog");

const locale = "en";
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured && data.locale == locale
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !data.featured && data.locale == locale
);

// Structured data for Hugo Nogueira as Person
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hugo Nogueira",
  jobTitle: "Chief Product & Technology Officer",
  worksFor: {
    "@type": "Organization",
    name: "Complyance",
    description: "Enterprise GRC (Governance, Risk & Compliance) Platform",
  },
  url: "https://hugo.im",
  sameAs: [
    "https://github.com/hugomn",
    "https://linkedin.com/in/hugomn",
    "https://twitter.com/hugomn",
  ],
  knowsAbout: [
    "Technology Leadership",
    "Product Strategy",
    "Engineering Leadership",
    "AI Platform Architecture",
    "LLM Pipeline Development",
    "Model Training and Fine-tuning",
    "AI System Deployment and Scaling",
    "Organizational Scaling",
    "Software Architecture",
    "Cloud Platforms",
    "Enterprise Software",
    "GRC Technology",
    "Team Management",
    "Strategic Planning",
    "TypeScript",
    "React",
    "Node.js",
    "Modern Development Practices",
  ],
  hasOccupation: {
    "@type": "Occupation",
    name: "Chief Product & Technology Officer",
    occupationLocation: {
      "@type": "Place",
      name: "Global/Remote",
    },
    skills: [
      "Executive Leadership",
      "Product Strategy",
      "AI Platform Architecture",
      "LLM System Development",
      "Model Training and Deployment",
      "Technology Architecture",
      "Team Scaling",
      "Enterprise Software Development",
    ],
  },
  description:
    "Chief Product & Technology Officer specializing in AI platform architecture, LLM system development, and scaling AI-enabled organizations. 20 years experience from individual contributor to C-level executive.",
};

// Website structured data
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "Website",
  name: "Hugo Nogueira - Technology Leadership & AI Development",
  url: "https://hugo.im",
  author: {
    "@type": "Person",
    name: "Hugo Nogueira",
    jobTitle: "Chief Product & Technology Officer",
  },
  description:
    "Technology leadership insights by Hugo Nogueira, CPTO at Complyance. Expertise in AI platform architecture, LLM system development, engineering leadership, and scaling AI-enabled organizations.",
  keywords:
    "technology leadership, CPTO, AI platform architecture, LLM development, model training, product strategy, engineering management, enterprise software, scaling teams",
  audience: {
    "@type": "Audience",
    name: "Technology Executives and Engineering Leaders",
  },
};
---

<Layout>
  <!-- Structured Data for LLM Optimization -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personStructuredData)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(websiteStructuredData)}
  />

  <Header />
  <main id="main-content">
    <Hero />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <div class="featured-container">
              <h2>Featured Posts</h2>
              <div class="featured-grid">
                {featuredPosts.map(({ data }, index) => (
                  <FeaturedCard
                    href={localizeUrl(
                      Astro.currentLocale,
                      `/posts/${data.postSlug}/`
                    )}
                    frontmatter={data}
                    lead={index === 0}
                  />
                ))}
              </div>
            </div>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={localizeUrl(
                      Astro.currentLocale,
                      `/posts/${data.postSlug}/`
                    )}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Featured Posts Section ===== */
  #featured {
    @apply pb-12 pt-10 md:pb-16 md:pt-12;
  }

  .featured-container {
    @apply mx-auto;
    max-width: 1280px;
  }

  .featured-grid {
    @apply mt-6 grid grid-cols-1 gap-5;
  }

  @media (min-width: 768px) {
    .featured-grid {
      @apply grid-cols-2;
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      @apply grid-cols-3;
    }
  }

  /* ===== Recent Posts Section ===== */
  #recent-posts {
    @apply pb-4 pt-10 md:pt-12;
  }
  #recent-posts h2,
  #featured h2 {
    @apply text-xl font-bold tracking-tight sm:text-2xl;
  }
  .all-posts-btn-wrapper {
    @apply mb-16 mt-6 px-4 text-center;
  }
  .all-posts-btn-wrapper :global(a) {
    @apply inline-flex items-center gap-1 rounded-full border border-skin-line px-5 py-2.5 font-semibold transition-colors hover:border-skin-accent;
  }
  .all-posts-btn-wrapper :global(svg) {
    @apply h-5 w-5;
  }
</style>
